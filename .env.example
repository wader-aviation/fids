# Neon Postgres (Vercel Marketplace sets this for you)
DATABASE_URL=
# Any long random string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Optional. Free key for Airframes feeders: email api@airframes.io
AIRFRAMES_API_KEY=
# Optional. FAA NOTAM Management Service (NMS-API) OAuth client. Without it NOTAMs are hidden.
NMS_CLIENT_ID=
NMS_CLIENT_SECRET=
